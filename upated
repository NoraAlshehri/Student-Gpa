        modifier = Modifier.padding(20.dp)
    )
}

@Preview()
@Composable
 fun StudentResultPreviewSuccessState() {
    StudentResultContent(
        examResult = true,
        onResultChange = {}
    )
}

@Preview
@Composable
 fun StudentResultPreviewFailedState() {
    StudentResultContent(
        examResult = false,
        onResultChange = {}
    )
}


