@Composable
fun StudentResultScreen() {
    var examResult by remember { mutableStateOf<Boolean?>(null) }
    StudentResultContent(
        examResult = examResult,
        onResultChange = { examResult = it }
    )
}
@Composable
fun StudentResultContent(
    modifier: Modifier = Modifier,
    examResult: Boolean?,
    onResultChange: (Boolean?) -> Unit
)
{
    Box(
        modifier = Modifier
            .fillMaxHeight(),
        contentAlignment = Alignment.Center
        ) {
    Column(
        modifier = modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(20.dp))
            .background(LightBlue11)
            .padding(36.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
        ) {
        Text(
            text = stringResource(R.string.student_result),
            fontWeight = FontWeight.Bold,
            fontSize = 24.sp
        )
        Spacer(modifier = Modifier.height(20.dp))

        when (examResult) {
            null -> {
                Image(
                    painter = painterResource(R.drawable.loading_error),
                    contentDescription = "failed loading",
                    modifier = Modifier
                   .padding(bottom = 6.dp)
                   .size(140.dp)
                )
                Text(
                    text = stringResource(R.string.check_test),
                    fontSize = 20.sp,
                    color = Gray1,
                    modifier = Modifier.padding(12.dp)
                )
            }

            true -> {
                Image(
                    painter = painterResource(R.drawable.passes),
                    contentDescription = "Passed",
                    modifier = Modifier
                    .padding(bottom = 6.dp)
                     .size(140.dp)
                )
                Text(text = stringResource(R.string.passed_test),
                    fontSize = 20.sp,
                    color = androidx.compose.ui.graphics.Color(0xFF82949D),
                    modifier = Modifier.padding(12.dp)
                )
            }

            false -> {
                Image(
                    painter = painterResource(R.drawable.fails),
                    contentDescription = "fail",
                    modifier = Modifier
                        .padding(bottom = 6.dp)
                        .size(140.dp)
                )
                Text(
                    text = stringResource(R.string.failed_test),
                    textAlign = TextAlign.Center,
                    fontSize = 20.sp,
                    color = androidx.compose.ui.graphics.Color(0xFF82949D),
                    modifier = Modifier.padding(12.dp)
                )
            }


        }
        Button(
            onClick = {
                onResultChange(Random.nextBoolean())
            }
        ) {
            Text(
                text = if (examResult == null) {
                    "Try again"
                } else {
                    "Check result"
                }
            )
        }
    }
        }

}


