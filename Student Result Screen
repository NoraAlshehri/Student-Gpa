@Composable
fun StudentResultScreen() {
    var examResult by remember { mutableStateOf<Boolean?>(null) }
    StudentResultContent(
        examResult = examResult,
        onResultChange = { examResult = it }
    )
}
@Composable
fun StudentResultContent(
    examResult: Boolean?,
    onResultChange: (Boolean?) -> Unit
)
{

    Column(
        modifier = Modifier
            .fillMaxSize()
//            .clip(RoundedCornerShape(8.dp))
            .padding(40.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center,
    ) {

        Text(
            text = stringResource(R.string.student_result),
            fontWeight = FontWeight.Bold,
            fontSize = 24.sp
        )
        Spacer(modifier = Modifier.height(20.dp))

        when (examResult) {
            null -> {
                Image(
                    painter = painterResource(R.drawable.loading_error),
                    contentDescription = "failed loading",
                    modifier = Modifier.size(140.dp)
                )
                Text(
                    text = stringResource(R.string.check_test),
                    fontSize = 20.sp,
                )

            }
            true -> {
                Image(
                    painter = painterResource(R.drawable.passes),
                    contentDescription = "Passed",
                    modifier = Modifier.size(140.dp)
                )
                Text(text = stringResource(R.string.passed_test),
                    fontSize = 20.sp
                )

            }
            false -> {
                Image(
                    painter = painterResource(R.drawable.fails),
                    contentDescription = "fail",
                    modifier = Modifier.size(140.dp)
                )
                Text(
                    text = stringResource(R.string.failed_test),
                    fontSize = 20.sp
                )
            }
        }
        Spacer(modifier = Modifier.height(28.dp))
        Button(
            onClick = {
                onResultChange(Random.nextBoolean())
            }
        ) {
            Text(
                text = if (examResult == null) {
                    "Try again"
                } else {
                    "Check result"
                }
            )
        }
    }

}


@Preview
