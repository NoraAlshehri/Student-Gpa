examResult: Boolean?,
    onResultChange: (Boolean?) -> Unit
)

Box(
            modifier = Modifier
                .fillMaxWidth(0.85f)
                .clip(RoundedCornerShape(16.dp))
                .background(MaterialTheme.colorScheme.surface)
                .padding(24.dp)
        )


Spacer(modifier = Modifier.height(24.dp))
Button(
    onClick = {
        onResultChange(Random.nextBoolean())
    }
) {
    Text(
        text = if (examResult == null) {
            "Try again"
        } else {
            "Check result"
        }
    )
}
